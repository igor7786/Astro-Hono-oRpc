{
  "name": "astro-template",
  "type": "module",
  "version": "0.0.6",
  "engines": {
    "bun": "^1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "bun:dev": "bun --env-file=.env --bun astro dev --host",
    "bun:build": "bun --env-file=.env --bun astro build && bun --env-file=.env --bun astro build",
    "bun:preview": "HOST=0.0.0.0 PORT=4321 bun --env-file=.env --bun run ./dist/server/entry.mjs",
    "check:astro": "prettier --check \"./**/*.astro\"",
    "check:lint": "vp lint --fix",
    "check:ts": "astro check && bunx tsc --noEmit --incremental --tsBuildInfoFile ./node_modules/.cache/tsbuildinfo",
    "check": "bun run check:lint && bun run check:ts && bun run check:astro",
    "format:vite+": "vp fmt . --write",
    "format:astro": "prettier --write \"src/**/*.astro\"",

    "format": "bun run format:vite+ && bun run format:astro",
    "redis:vps:test": "bun run --bun ./src/lib/redis/test.client.redis.vps.ts",
    "rustfs:vps:test": "bun run --bun ./src/lib/s3/test.client.rustfs.vps.ts",
    "neon:test": "bun run --bun ./src/lib/drizzle/neon/test.client.neon.db.ts",
    "pg:vps:test": "bun run --bun ./src/lib/drizzle/pg/test.client.pg.db.ts",
    "sqlite:test": "bun run --bun ./src/lib/drizzle/sqlite/test.client.sqlite.ts",
    "env:test": "bun run --bun ./src/lib/env/test.env.ts",
    "redpanda:vps:test": "bun run --bun ./src/lib/redpanda-kafka/test.redpanda.vps.ts",
    "tinybird:vps:test": "bun run --bun ./src/lib/tinybird/redpanda.test.tinybird.ts",
    "og:test": "bun run --bun ./src/server/seo/og/test-simple-og.ts",
    "generate:contract": "bun run --bun ./src/server/contracts/helpers/generate-contract-json.ts",
    "db:sqlite:generate": "bunx drizzle-kit generate --config ./src/lib/drizzle/sqlite/drizzle.config.ts",
    "db:neon:generate": "bunx drizzle-kit generate --config ./src/lib/drizzle/neon/drizzle.config.ts",
    "db:pg:generate": "bunx drizzle-kit generate --config ./src/lib/drizzle/pg/drizzle.config.ts",
    "db:sqlite:migrate": "bunx drizzle-kit migrate --config ./src/lib/drizzle/sqlite/drizzle.config.ts",
    "db:neon:migrate": "bunx drizzle-kit migrate --config ./src/lib/drizzle/neon/drizzle.config.ts",
    "db:pg:migrate": "bunx drizzle-kit migrate --config ./src/lib/drizzle/pg/drizzle.config.ts",
    "db:sqlite:studio": "bunx drizzle-kit studio --port 3001 --config ./src/lib/drizzle/sqlite/drizzle.config.ts",
    "db:neon:studio": "bunx drizzle-kit studio --port 3001 --config ./src/lib/drizzle/neon/drizzle.config.ts",
    "db:pg:studio": "bunx drizzle-kit studio --port 3001 --config ./src/lib/drizzle/pg/drizzle.config.ts",
    "knip": "knip --no-exit-code",
    "knip:fix": "knip --fix --no-exit-code",
    "husky:init": "bunx husky init",
    "prepare": "husky",
    "tinybird:dev": "tinybird dev",
    "tinybird:build": "tinybird build",
    "tinybird:deploy": "tinybird deploy",
    "tinybird:preview": "tinybird preview"
  },
  "lint-staged": {
  "*.astro": ["bunx prettier --write"],
  "*.{ts,tsx,js,jsx,css,scss,md,html,mjs}": ["bunx vp fmt"]
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@iconify-json/gravity-ui": "^1.2.15",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/selfhst": "^1.2.25",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@nanostores/persistent": "^1.3.3",
    "@nanostores/react": "^2.0.1",
    "@orpc/client": "^1.15.7",
    "@orpc/json-schema": "^1.15.7",
    "@orpc/openapi": "^1.15.7",
    "@orpc/openapi-client": "^1.15.7",
    "@orpc/server": "^1.15.7",
    "@orpc/tanstack-query": "^1.15.7",
    "@orpc/zod": "^1.15.7",
    "@platformatic/kafka": "^2.14.0",
    "@scalar/hono-api-reference": "^0.12.13",
    "@scalar/openapi-to-markdown": "^1.6.0",
    "@smithy/node-http-handler": "^4.11.3",
    "@tailwindcss/vite": "^4.2.2",
    "@takumi-rs/image-response": "^2.16.3",
    "@tanstack/query-async-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "@tinybirdco/sdk": "^0.0.84",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wyattjoh/astro-bun-adapter": "^2.1.1",
    "add": "^2.0.6",
    "astro": "7.4.0",
    "astro-iconset": "^0.0.6",
    "boneyard-js": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "he": "^2.0.0",
    "hono": "^4.13.13",
    "idb-keyval": "^6.2.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.58.0",
    "nanostores": "^1.5.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "satori": "^0.62.0",
    "shadcn": "^4.22.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.4.3",
    "@types/he": "^1.2.3",
    "@types/pg": "^8.20.4",
    "@types/prismjs": "^1.26.6",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxlint-tailwindcss": "^1.16.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-classnames": "^0.10.1",
    "prettier-plugin-merge": "^0.10.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.3.0"
  }
}
