{
  "name": "astro-template",
  "type": "module",
  "version": "0.0.2",
  "engines": {
    "bun": "^1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "bun:dev": "bunx --bun astro dev --host",
    "bun:build": "bunx --bun astro build",
    "bun:preview": "HOST=0.0.0.0 PORT=4322 bun run --bun ./dist/server/entry.mjs",
    "ts:check": "astro check && bunx tsc --noEmit --incremental --tsBuildInfoFile ./node_modules/.cache/tsbuildinfo",
    "format": "bunx prettier --write \"./**/*.{ts,tsx,js,jsx,json,css,scss,md,astro,html,mjs}\"",
    "redis:vps:test": "bun run --bun ./src/lib/redis/test.client.redis.vps.ts",
    "rustfs:vps:test": "bun run --bun ./src/lib/s3/test.client.rustfs.vps.ts",
    "pg:vps:test": "bun run --bun ./src/lib/drizzle/pg/test.client.pg.db.ts",
    "sqlite:test": "bun run --bun ./src/lib/drizzle/sqlite/test.client.sqlite.ts",
    "env:test": "bun run --bun ./src/lib/env/test.env.ts",
    "redpanda:vps:test": "bun run --bun ./src/lib/redpanda-kafka/test.redpanda.vps.ts",
    "tinybird:vps:test": "bun run --bun ./src/lib/tinybird/redpanda.test.tinybird.ts",
    "og:test": "bun run --bun ./src/server/seo/og/test-simple-og.ts",
    "generate:contract": "bun run --bun ./src/server/contracts/helpers/generate-contract-json.ts",
    "db:sqlite:generate": "bunx drizzle-kit generate --config ./src/lib/drizzle/sqlite/drizzle.config.ts",
    "db:pg:generate": "bunx drizzle-kit generate --config ./src/lib/drizzle/pg/drizzle.config.ts",
    "db:sqlite:migrate": "bunx drizzle-kit migrate --config ./src/lib/drizzle/sqlite/drizzle.config.ts",
    "db:pg:migrate": "bunx drizzle-kit migrate --config ./src/lib/drizzle/pg/drizzle.config.ts",
    "db:sqlite:studio": "bunx drizzle-kit studio --port 3001 --config ./src/lib/drizzle/sqlite/drizzle.config.ts",
    "db:pg:studio": "bunx drizzle-kit studio --port 3001 --config ./src/lib/drizzle/pg/drizzle.config.ts",
    "knip": "knip --no-exit-code",
    "knip:fix": "knip --fix --no-exit-code",
    "husky:init": "bunx husky init",
    "prepare": "husky",
    "tinybird:dev": "tinybird dev",
    "tinybird:build": "tinybird build",
    "tinybird:deploy": "tinybird deploy",
    "tinybird:preview": "tinybird preview"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro,json,css,scss,md,html}": [
      "bunx prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/lib-storage": "^3.1072.0",
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/node-server": "^2.0.1",
    "@hono/zod-validator": "^0.8.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/selfhst": "^1.2.11",
    "@iconify-json/skill-icons": "^1.2.4",
    "@nanostores/persistent": "^1.3.3",
    "@nanostores/react": "^1.1.0",
    "@orpc/client": "^1.13.9",
    "@orpc/json-schema": "^1.13.9",
    "@orpc/openapi": "^1.13.9",
    "@orpc/openapi-client": "^1.13.13",
    "@orpc/server": "^1.13.9",
    "@orpc/tanstack-query": "^1.13.9",
    "@orpc/zod": "^1.13.8",
    "@platformatic/kafka": "^2.4.0",
    "@scalar/hono-api-reference": "^0.11.5",
    "@scalar/openapi-to-markdown": "^0.5.12",
    "@smithy/node-http-handler": "^4.8.1",
    "@tailwindcss/vite": "^4.2.2",
    "@takumi-rs/image-response": "^2.0.3",
    "@tanstack/query-async-storage-persister": "^5.94.5",
    "@tanstack/react-query": "^5.94.5",
    "@tanstack/react-query-persist-client": "^5.94.5",
    "@tinybirdco/sdk": "^0.0.81",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "add": "^2.0.6",
    "astro": "7.1.1",
    "astro-iconset": "^0.0.6",
    "boneyard-js": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "idb-keyval": "^6.2.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.8.0",
    "nanostores": "^1.2.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "satori": "^0.26.0",
    "shadcn": "^4.0.8",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.94.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^6.4.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-classnames": "^0.10.1",
    "prettier-plugin-merge": "^0.10.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.2"
  }
}
