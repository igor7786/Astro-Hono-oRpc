{
  "name": "astro-template",
  "type": "module",
  "version": "0.0.2",
  "engines": {
    "bun": "^1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "bun:dev": "bunx --bun astro dev --host",
    "bun:build": "bunx --bun astro build",
    "bun:preview": "HOST=0.0.0.0 PORT=4322 bun run --bun ./dist/server/entry.mjs",
    "ts:check": "astro check && bunx tsc --noEmit --incremental --tsBuildInfoFile ./node_modules/.cache/tsbuildinfo",
    "format": "bunx prettier --write \"./**/*.{ts,tsx,js,jsx,json,css,scss,md,astro,html,mjs}\"",
    "redis:vps:connect": "bun run ./src/lib/queues/redis.vps.ts",
    "og:test": "bun run src/lib/server/seo/og/test-simple-og.ts",
    "knip": "knip --no-exit-code",
    "knip:fix": "knip --fix --no-exit-code",
    "husky:init": "bunx husky init",
    "prepare": "husky",
    "generate:contract": "bun run src/server/contracts/helpers/generate-contract-json.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro,json,css,scss,md,html}": ["bunx prettier --write"]
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@astrojs/sitemap": "3.7.3",
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/lib-storage": "^3.1072.0",
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/node-server": "^2.0.5",
    "@hono/zod-validator": "^0.8.0",
    "@nanostores/persistent": "^1.3.3",
    "@nanostores/react": "^1.1.0",
    "@orpc/client": "^1.14.6",
    "@orpc/json-schema": "^1.14.6",
    "@orpc/openapi": "^1.14.6",
    "@orpc/openapi-client": "^1.14.6",
    "@orpc/server": "^1.14.6",
    "@orpc/tanstack-query": "^1.14.6",
    "@orpc/zod": "^1.14.6",
    "@scalar/hono-api-reference": "^0.11.4",
    "@scalar/openapi-to-markdown": "^0.5.26",
    "@smithy/node-http-handler": "^4.8.1",
    "@tailwindcss/vite": "^4.3.1",
    "@takumi-rs/image-response": "^1.8.6",
    "@tanstack/query-async-storage-persister": "^5.94.5",
    "@tanstack/react-query": "^5.94.5",
    "@tanstack/react-query-persist-client": "^5.94.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wyattjoh/astro-bun-adapter": "^2.0.1",
    "add": "^2.0.6",
    "astro": "6.4.8",
    "boneyard-js": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.25",
    "idb-keyval": "^6.2.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.20.0",
    "mdast-util-to-string": "^4.0.0",
    "nanostores": "^1.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reading-time": "^1.5.0",
    "satori": "^0.26.0",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.94.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.11",
    "husky": "^9.1.7",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-classnames": "^0.10.1",
    "prettier-plugin-merge": "^0.10.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.2"
  }
}
