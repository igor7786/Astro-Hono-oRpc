---
import { seoSchema, baseSeo } from '@/lib/shared/schemas/seo.schema';
import z from 'zod';
import { ogPath, openApiBasePath } from '@/lib/helpers/paths';
import { envServer } from '@/lib/env/server.env';
import { generateOgParamsId, generateOgToken } from '@/server/seo/og/og.generate.token.id';
import { redisVps } from '@/lib/redis/client.redis.vps';
import ttl, { ogParamsKey } from '@/lib/redis/ttl';
import { sqliteDb } from '@/lib/drizzle/sqlite/client';
import { ogImages } from '@/lib/drizzle/sqlite/schema';
// ✅ Safe parse (no crash in production)
const result = seoSchema.safeParse({
  ...baseSeo,
  ...Astro.props,
  url: envServer.PUBLIC_URL,
});

if (!result.success) {
  console.error('[SEO] Invalid props:', z.treeifyError(result.error));
}

// ✅ fallback to safe defaults
const seo = result.success ? result.data : seoSchema.parse(baseSeo);

const { title, description, author, date, type, siteName, siteUrl, url = Astro.url.href } = seo;
let ogAuthor = author;
if (!ogAuthor) ogAuthor = 'Alberto';

// hex id, token, and other params for OG image generation
const id = generateOgParamsId({ title, description, author: ogAuthor, date });
const token = generateOgToken(id);
// REDIS caching for OG image generation
const paramsKey = ogParamsKey(id);
console.log('[paramsKey]', paramsKey);
// Check if the OG params already exist in Redis
try {
  const existing = await redisVps.hgetall(paramsKey);
  const isNew = !existing || Object.keys(existing).length === 0;
  if (isNew) {
    console.log('New OG params, caching in Redis...');
    await redisVps.hset(paramsKey, {
      title,
      description,
      ...(author && { author }),
      ...(date && { date }),
    });
    await redisVps.expire(paramsKey, ttl['1w']); // Set expiration time for 1 week
  }
} catch (error) {
  console.error(console.error('[error] Redis unavailable 📛, writing straight to SQLite -> ⏳'));
  // If Redis is unavailable, write to SQLite
  try {
    const db = sqliteDb;
    await db
      .insert(ogImages)
      .values({
        id,
        title,
        description,
        author,
        date,
        format: 'png',
      })
      .onConflictDoUpdate({
        target: ogImages.id,
        set: { title, description, author, date },
      });
  } catch (sqliteErr) {
    console.error('[error] SQLite write also failed 📛');
  }
}

// 🚀 SAFE Page URL BUILDER
const pageURL = new URL(Astro.url.pathname, envServer.PUBLIC_URL);
// 🚀 SAFE OG IMAGE URL BUILDER (FIXED)
const fullPath = openApiBasePath + ogPath;
const ogUrl = new URL(fullPath, envServer.PUBLIC_URL);

ogUrl.searchParams.set('id', id);
ogUrl.searchParams.set('token', token);
ogUrl.searchParams.set('format', 'png');
const ogImageUrl = ogUrl.toString();
---

<!-- BASIC SEO -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0f172a" />
<link rel="canonical" href={pageURL} />

<!-- OPEN GRAPH -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageURL} />
<Fragment set:html={`<meta property="og:image" content="${ogImageUrl}" />`} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{type === 'article' && <meta property="article:published_time" content={date} />}
{type === 'article' && <meta property="article:author" content={author} />}

<!-- TWITTER -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@IGrimuta" />
<meta name="twitter:creator" content="@IGrimuta" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<Fragment set:html={`<meta name="twitter:image" content="${ogImageUrl}" />`} />
<!-- SITEMAP -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- JSON-LD STRUCTURED DATA -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': type === 'article' ? 'Article' : 'WebSite',
    '@id': pageURL,
    name: title,
    url: pageURL,
    description,
    ...(author && {
      author: {
        '@type': 'Person',
        name: author,
      },
    }),
    ...(date && {
      datePublished: date,
    }),
  })}
/>
