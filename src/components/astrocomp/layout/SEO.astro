---
import { seoSchema, baseSeo } from '@/lib/shared/schemas/seo/seo.schema';
import z from 'zod';
import { eq } from 'drizzle-orm';
import { ogPath, openApiBasePath } from '@/lib/helpers/paths';
import { envServer } from '@/lib/env/server.env';
import { generateOgParamsId, generateOgToken } from '@/lib/crypto/og.image.id.url';
import { neonDb } from '@/lib/drizzle/neon/client.neon.db';
import { ogImages } from '@/lib/drizzle/neon/schemas';
// ✅ Safe parse (no crash in production)
const result = seoSchema.safeParse({
  ...baseSeo,
  ...Astro.props,
  siteUrl: new URL(Astro.url.href, envServer.PUBLIC_URL).toString(),
});
if (!result.success) {
  console.error('[SEO] Invalid props:', z.treeifyError(result.error));
}

// ✅ fallback to safe defaults
const seo = result.success ? result.data : seoSchema.parse(baseSeo);

const { title, description, author, date, type, siteName, siteUrl = Astro.url.href } = seo;

// hex id, token, and other params for OG image generation
const id = generateOgParamsId({ title, description, author, date });
const token = generateOgToken(id);

try {
  // SQLite caching for OG image generation
  // Check if the OG params already exist in SQLite
  const rows = await neonDb.select().from(ogImages).where(eq(ogImages.id, id)).limit(1);
  const existing = rows[0] ?? null;
  const isNew = !existing;
  if (isNew) {
    // Save the OG params to SQLite
    await neonDb
      .insert(ogImages)
      .values({
        id,
        token,
        title,
        description,
        author,
        date,
      })
      .onConflictDoUpdate({
        target: ogImages.id,
        set: {
          token,
          title,
          description,
          author,
          date,
        },
      });
  }
} catch (error) {
  console.error(error);
  console.error('[error] NeonDB unavailable 📛');
}
// 🚀 SAFE Page URL BUILDER

// 🚀 SAFE OG IMAGE URL BUILDER (FIXED)
const fullPath = openApiBasePath + ogPath;
const ogUrl = new URL(fullPath, envServer.PUBLIC_URL);

ogUrl.searchParams.set('id', id);
ogUrl.searchParams.set('format', 'png');
const ogImageUrl = ogUrl.toString();
---

<!-- BASIC SEO -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0f172a" />
<link rel="canonical" href={siteUrl} />

<!-- OPEN GRAPH -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={siteUrl} />
<Fragment set:html={`<meta property="og:image" content="${ogImageUrl}" />`} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{type === 'article' && <meta property="article:published_time" content={date} />}
{type === 'article' && <meta property="article:author" content={author} />}

<!-- TWITTER -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@IGrimuta" />
<meta name="twitter:creator" content="@IGrimuta" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<Fragment set:html={`<meta name="twitter:image" content="${ogImageUrl}" />`} />
<!-- SITEMAP -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- JSON-LD STRUCTURED DATA -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': type === 'article' ? 'Article' : 'WebSite',
    '@id': siteUrl,
    name: title,
    url: siteUrl,
    description,
    ...(author && {
      author: {
        '@type': 'Person',
        name: author,
      },
    }),
    ...(date && {
      datePublished: date,
    }),
  })}
/>
