---
// src/components/SEO.astro
import { buildSeoHead } from '@/lib/seo/build.seo.head';
import { resolveSeo } from '@/lib/seo/seo.core';
import { siteLinks, siteMeta } from '@/lib/seo/site.head';

const seo = await resolveSeo(Astro.props, Astro.url.pathname);
const { meta, links, scripts } = buildSeoHead(seo);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
{siteMeta.map((m) => (
  <meta {...m} />
))}
{siteLinks.map((l) => (
  <link {...l} />
))}

{meta.map((m) => ('title' in m ? <title>{m.title}</title> : <meta {...m} />))}
{links.map((l) => (
  <link {...l} />
))}
{scripts.map((s) => (
  <script is:inline type={s.type} set:html={s.children} />
))}
