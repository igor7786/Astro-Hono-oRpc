---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/shared/schemas/seo/seo.schema';

type Props = {
  post: CollectionEntry<'blog'>;
  readingTime: string;
};
const { post, readingTime } = Astro.props as Props;
const { id } = post;
const { title, description, author, date, tags } = post.data;

const formattedDate = formatDate(date?.toISOString());
---

<a href={`/playground/blog/${id}`} class="group">
  <article class="flex flex-col gap-3 border-b border-border pb-10">
    {tags && (
      <div class="flex gap-2">
        {tags.map((tag: string) => (
          <span class="rounded-full bg-muted px-2 py-1 text-xs text-muted-foreground">{tag}</span>
        ))}
      </div>
    )}

    <h2 class="font-heading text-3xl font-bold transition-colors group-hover:text-primary">{title}</h2>

    {description && <p class="text-lg text-muted-foreground">{description}</p>}

    <div class="flex items-center gap-3 text-sm text-muted-foreground">
      {author && <span>👤 {author}</span>}
      {author && date && <span>• 📅</span>}
      {formattedDate && <span>{formattedDate}</span>}
      {readingTime && <span>•</span>}
      {readingTime && <span>⚡ {readingTime}</span>}
    </div>

    <span class="text-sm font-medium text-primary group-hover:underline">Read more →</span>
  </article>
</a>
