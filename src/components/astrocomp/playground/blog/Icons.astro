    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="skill-icons:vite-light" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:react-query-icon" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="ui:drizzle" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:tailwindcss-icon" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
