---
import { Icon } from 'astro-iconset/components';
---

<div class="mx-auto flex max-w-5xl flex-col items-center justify-center px-6 py-6 text-center">
  <h1 class="text-foreground mx-auto mb-2 text-6xl font-bold">Welcome</h1>
  <p class="text-muted-foreground mb-12 text-xl">Browse all available pages</p>
  <div
    class="border-border hover:border-primary mb-6 flex flex-wrap items-center justify-center gap-3 rounded-lg border px-4 py-4 md:gap-4"
  >
    <Icon name="logos:nginx" size={48} />
    <Icon name="selfhst:crowdsec" size={48} />
    <Icon name="logos:bun" size={52} />
    <Icon name="skill-icons:astro" size={48} />
    <Icon name="ui:redpanda" size={48} />
    <Icon name="logos:hono" size={48} />
    <Icon name="ui:oRpc" size={80} />
    <Icon name="logos:zod" size={48} />
    <Icon name="selfhst:rustfs" size={38} />
    <Icon name="logos:postgresql" size={48} />
    <Icon name="logos:sqlite" size={96} />
    <Icon name="ui:dragonfly" size={64} />
    <Icon name="skill-icons:vite-light" size={48} />
    <Icon name="logos:react-query-icon" size={48} />
    <Icon name="ui:drizzle" size={48} />
    <Icon name="logos:tailwindcss-icon" size={64} />
    <Icon name="logos:react" size={48} />
    <Icon name="ui:nanostores" size={48} />
  </div>
</div>
