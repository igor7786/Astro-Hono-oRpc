---
import { Icon } from 'astro-iconset/components';
---

<div class="mx-auto flex max-w-5xl flex-col items-center justify-center px-6 py-6 text-center">
  <h1 class="mx-auto mb-2 text-6xl font-bold text-foreground">Welcome</h1>
  <p class="mb-12 text-xl text-muted-foreground">Browse all available pages</p>
  <div class="mb-6 flex flex-wrap items-center justify-center gap-3 rounded-lg border border-border bg-panel/80 px-4 py-4 hover:border-primary md:gap-4">
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:nginx" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="selfhst:crowdsec" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:bun" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="skill-icons:astro" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="ui:redpanda" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:hono" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="ui:oRpc" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:zod" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="selfhst:rustfs" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:postgresql" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:neon-icon" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
      <Icon name="logos:sqlite" size={48} />
    </div>
    <div class="gap-3 rounded-lg border border-border px-4 py-4 hover:border-primary md:gap-4">
