---
import { createSeo } from '@/lib/shared/schemas/seo/seo.schema';
import Layout from '@/layouts/Layout.astro';
import { discoverRoutes } from '@/lib/helpers/paths';
import { adminRoutes } from '@/lib/helpers/icons';
import Icons from '@/components/astrocomp/playground/blog/Icons.astro';
import TestClients from '@/components/reactcomp/playground/TestClients';
import { GeoDebugCard } from '@rcomp/playground/GeoDebugCard';

// Import your clean native Astro card component instead of the React one
import RouteListCard from '@acomp/playground/blog/RouteListCard.astro';

export const prerender = true;

const allFiles = import.meta.glob('../pages/**/*.{astro,ts,tsx,js,jsx}', {
  eager: true,
});
const { ssrRoutes, staticRoutes } = await discoverRoutes(allFiles);

const seo = createSeo({
  title: 'Playground | Home',
  description: 'Powered by Astro + Hono + oRPC',
  type: 'website',
});
---

<Layout {...seo}>
  <Icons slot="header" />
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-center px-6 py-6 text-center"
    slot="main"
  >
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
      <!-- Clean, zero client-overhead server rendering -->
      <RouteListCard accent="ssr" badgeLabel="SSR" title="Server Pages" items={ssrRoutes} />
      <RouteListCard accent="static" badgeLabel="Static" title="Static Pages" items={staticRoutes} />
      <RouteListCard accent="admin" badgeLabel="Admin" title="Admin Pages" items={adminRoutes} masked />

      <!-- Interactive React cards still live happily right next to them -->
      <TestClients client:only="react" />
      <GeoDebugCard client:only="react" />
    </div>
  </div>
</Layout>
