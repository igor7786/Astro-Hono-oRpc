---
import { createSeo } from '@/lib/shared/schemas/seo.schema';
import Layout from '@/layouts/Layout.astro';
import { discoverRoutes } from '@/lib/helpers/paths';
import { Icon } from 'astro-iconset/components';
export const prerender = true;
export async function getStaticPaths() {
  return [{ params: {} }];
}

const allFiles = import.meta.glob('../pages/**/*.{astro,ts,tsx,js,jsx}', {
  eager: true,
});
const { ssrRoutes, staticRoutes } = await discoverRoutes(allFiles);

const adminRoutes = [
  {
    icon: 'simple-icons:ionos',
    route: 'https://www.ionos.co.uk/',
    label: 'Ionos-Admin',
    size: 28,
  },
  { icon: 'selfhst:arcane', route: 'https://arcane.fast-web-tech.co.uk/', label: 'Arcane', size: 24 },
  { icon: 'logos:nginx', route: 'https://npm.fast-web-tech.co.uk/', label: 'Npm Admin', size: 24 },
  {
    icon: 'ui:redpanda',
    route: 'https://redpanda-console.fast-web-tech.co.uk/',
    label: 'Redpanda-Console',
    size: 24,
  },
  {
    icon: 'ui:dragonfly',
    route: 'https://redis-insight.fast-web-tech.co.uk/',
    label: 'Dragonfly-Console',
    size: 28,
  },
  {
    icon: 'selfhst:rustfs',
    route: 'https://rustfs.fast-web-tech.co.uk/',
    label: 'Rustfs-Admin',
    size: 24,
  },
  {
    icon: 'selfhst:authentik',
    route: 'https://auth.fast-web-tech.co.uk/',
    label: 'Authentik-Admin',
    size: 24,
  },
  {
    icon: 'lucide:logs',
    route: 'https://logs.fast-web-tech.co.uk/',
    label: 'Logs-Admin',
    size: 24,
  },
  { icon: 'simple-icons:scalar', route: '/api/docs', label: 'OpenAPI Docs', size: 24 },
];

const seo = createSeo({
  title: 'Playground | Home',
  description: 'Powered by Astro + Hono + oRPC',
  date: new Date(2026, 3, 15).toISOString(),
  type: 'website',
});
---

<Layout {...seo}>
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-center px-6 py-16 text-center"
    slot="main"
  >
    <h1 class="text-foreground mx-auto mb-2 text-6xl font-bold">Welcome</h1>
    <!-- <div class="mb-6 flex items-center justify-center gap-4">
      <img src="/icons/astro-dark.svg" alt="Astro Dark Logo" width="48" height="48" />
      +
      <img src="/icons/hono.svg" alt="Hono Logo" width="48" height="48" />
      ->
      <img src="/icons/postgresql.svg" alt="PostgreSQL Logo" width="48" height="48" />
      ->
      <img src="/icons/sqlite.svg" alt="SQLite Logo" width="96" height="96" />
      ->
      <img src="/icons/dragonfly.svg" alt="Dragonfly Logo" width="48" height="48" />
    </div> -->
    <div
      class="border-border hover:border-primary mb-6 flex flex-wrap items-center justify-center gap-3 rounded-lg border px-4 py-4 md:gap-4"
    >
      <Icon name="logos:nginx" size={48} />
      <Icon name="logos:bun" size={52} />
      <Icon name="skill-icons:astro" size={48} />
      <Icon name="ui:redpanda" size={48} />
      <Icon name="logos:hono" size={48} />
      <Icon name="ui:oRpc" size={80} />
      <Icon name="logos:zod" size={48} />
      <Icon name="selfhst:rustfs" size={38} />
      <Icon name="logos:postgresql" size={48} />
      <Icon name="logos:sqlite" size={96} />
      <Icon name="ui:dragonfly" size={64} />
      <Icon name="skill-icons:vite-light" size={48} />
      <Icon name="logos:react-query-icon" size={48} />
      <Icon name="ui:drizzle" size={48} />
      <Icon name="logos:tailwindcss-icon" size={64} />
      <Icon name="logos:react" size={48} />
      <Icon name="ui:nanostores" size={48} />
    </div>
    <p class="text-muted-foreground mb-12 text-xl">Browse all available pages</p>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 md:grid-cols-2">
      <!-- SSR -->
      <div>
        <h2 class="text-foreground mb-4 flex items-center gap-2 font-semibold">
          <span class="bg-primary/10 text-primary rounded px-2 py-0.5 text-xs">SSR</span>
          Server Pages
          <span class="text-muted-foreground text-sm font-normal">({ssrRoutes.length})</span>
        </h2>
        <ul class="space-y-2">
          {
            ssrRoutes.map(({ route, label }) => (
              <li>
                <a
                  href={route}
                  class="border-border hover:border-primary hover:text-primary flex items-center gap-2 rounded-lg border px-3 py-2 text-sm transition-colors"
                >
                  <span class="text-muted-foreground font-mono text-xs">{route}</span>
                  <span class="ml-auto">{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Static -->
      <div>
        <h2 class="text-foreground mb-4 flex items-center gap-2 font-semibold">
          <span class="rounded bg-green-500/10 px-2 py-0.5 text-xs text-green-600 dark:text-green-400">
            Static
          </span>
          Static Pages
          <span class="text-muted-foreground text-sm font-normal">({staticRoutes.length})</span>
        </h2>
        <ul class="space-y-2">
          {
            staticRoutes.map(({ route, label }) => (
              <li>
                <a
                  href={route}
                  class="border-border hover:border-primary hover:text-primary flex items-center gap-2 rounded-lg border px-3 py-2 text-sm transition-colors"
                >
                  <span class="font-mono text-xs text-green-600 dark:text-green-400">{route}</span>
                  <span class="ml-auto">{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- API -->
      <div>
        <h2 class="text-foreground mb-4 flex items-center gap-2 font-semibold">
          <span class="rounded bg-blue-500/10 px-2 py-0.5 text-xs text-blue-600 dark:text-blue-400">
            Admin
          </span>
          Admin Pages
          <span class="text-muted-foreground text-sm font-normal">({adminRoutes.length})</span>
        </h2>
        <ul class="space-y-2">
          {
            adminRoutes.map(({ icon, route, label, size }) => (
              <li>
                <a
                  href={route}
                  class="border-border hover:border-primary hover:text-primary flex items-center justify-center gap-4 rounded-lg border px-3 py-2 text-sm transition-colors"
                >
                  <Icon name={icon} size={size} class="text-blue-600 dark:text-blue-400" />
                  <span class="font-mono text-xs text-blue-600 dark:text-blue-400">----------</span>
                  <span class="ml-auto">{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Layout>
