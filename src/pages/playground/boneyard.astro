---
import { getImage } from 'astro:assets';
import { call } from '@orpc/server';

import Layout from '@/layouts/Layout.astro';
import CardTopImageDemo from '@rcomp/shadcn-studio/CardStudio';
import cardImage from '@/assets/card.webp';
import { createSeo } from '@/lib/shared/schemas/seo/seo.schema';
import { allRouters } from '@/server/routers/all.routers';

const inputData = {
  name: 'Smooth, flowing gradients blending rich reds and blues in an abstract swirl.',
};

const optimizedImage = await getImage({ src: cardImage, format: 'avif' });

let data: { name: string } | null = null;

try {
  data = await Promise.race([
    // No `await` in here: the race only works if the promise is passed in unresolved
    call(allRouters.tests.slowTest, inputData, {
      context: { request: Astro.request }, // placeholder: match your base procedure's context
    }),
    new Promise<null>((resolve) => setTimeout(() => resolve(null), 300)),
  ]);
} catch (e) {
  // server fetch failed → fall back to client-side fetch
  console.error('prefetch failed:', e instanceof Error ? e.message : e);
}

const name = data?.name ?? null;
const seo = createSeo({
  title: 'Skeleton Test',
  description: 'Powered by Astro + Hono + oRPC',
  type: 'website',
});
---

<Layout {...seo}>
  <div class="flex min-h-screen flex-col items-center justify-center gap-4" slot="main">
    <CardTopImageDemo
      client:load
      initialData={name}
      input={`${inputData.name}(client:load)`}
      imageSrc={optimizedImage.src}
      slot="main"
    />
    <CardTopImageDemo
      client:only="react"
      initialData={name}
      input={`${inputData.name}(client:only="react")`}
      imageSrc={optimizedImage.src}
      slot="main"
    />
    <CardTopImageDemo
      client:idle={{ timeout: 2000 }}
      initialData={name}
      input={`${inputData.name}(client:idle:max-delay-2s)`}
      imageSrc={optimizedImage.src}
      slot="main"
    />
    <div class="h-[150vh]" slot="main">
      Offset 150vh starts
    </div>

    <CardTopImageDemo
      client:visible={{ rootMargin: '75px' }}
      initialData={name}
      input={`${inputData.name}(client:visible:offset-75px)`}
      imageSrc={optimizedImage.src}
      slot="main"
    />
    <div class="mb-32" slot="main">
      Offset 150vh ends
    </div>
  </div>
</Layout>
