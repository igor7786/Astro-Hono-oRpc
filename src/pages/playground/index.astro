---
import { call } from '@orpc/server';

import Layout from '@/layouts/Layout.astro';
import SlowRequest from '@rcomp/playground/SlowRequest';
import { TestClient } from '@rcomp/playground/TestClient';
import UserProfile from '@rcomp/playground/TestTanstackQuery';
import { createSeo } from '@/lib/shared/schemas/seo/seo.schema';
import { allRouters } from '@/server/routers/all.routers';

// Placeholder context: match what your Hono handler passes into oRPC
const context = { request: Astro.request };

let data: { name: string } = { name: '' };
try {
  data = await call(allRouters.tests.test, { name: 'test' }, { context });
} catch (error: unknown) {
  data = { name: (error as Error).message };
}

const names = ['curt', 'bob', 'charlie'];
const colors = ['text-green-700', 'text-blue-700', 'text-purple-700'];

const profiles = await Promise.all(
  names.map(async (name, index) => {
    const className = `text-3xl font-bold underline ${colors[index]}`;
    try {
      const initialData = await call(allRouters.tests.test, { name }, { context });
      return { name, initialData, className };
    } catch {
      return { name, initialData: undefined, className };
    }
  })
);

const props = {
  name: 'tanstack query with oRPC',
  className: 'text-3xl font-bold text-green-700 underline',
};

const seo = createSeo({
  title: 'Playground',
  description: 'Powered by Astro + Hono + oRPC',
  date: new Date(2026, 3, 15).toISOString(),
  type: 'website',
});
---

<Layout {...seo}>
  # oRPC Server
  <h1 slot="main" class="text-3xl font-bold text-indigo-700 underline">
    {data.name}
  </h1>
  <UserProfile {...props} slot="main" client:only="react" />
  # Slow Request Test
  <SlowRequest slot="main" client:only="react" />
  # oRPC Client
  <TestClient slot="main" className="text-3xl font-bold text-sky-700 underline" client:load /># Tanstack
  Query with oRPC
  {profiles.map((props) => (
    <UserProfile {...props} slot="footer" client:load />
  ))}
</Layout>
