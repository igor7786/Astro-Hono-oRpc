---
import { envServer } from '@/lib/env/server.env';
import { allRouters } from '@/server/routers/all.routers';

const llmsTxtPath = allRouters.seo.llmsTxt['~orpc'].route.path as string;

const redirectPath = envServer.PUBLIC_OPEN_API_BASE_PATH + llmsTxtPath;

// convince TS it's used
void redirectPath;

return Astro.redirect(redirectPath, 302);
