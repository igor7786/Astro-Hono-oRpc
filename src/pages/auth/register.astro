---
import Layout from '@/layouts/Layout.astro';
import { RegisterPage } from '@rcomp/auth/RegisterPage';
import { createSeo } from '@/lib/shared/schemas/seo/seo.schema';

export const prerender = false;

const seo = createSeo({
  title: 'Register',
  description: 'Create a new account',
  type: 'website',
});
---

<Layout {...seo}>
  <RegisterPage slot="main" client:load />
</Layout>
